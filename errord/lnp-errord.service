[Unit]
Description=LNP plain-language error notifications
PartOf=graphical-session.target
# plasma-workspace.target is Before graphical-session.target and also waits
# for this wanted unit. Ordering after graphical-session.target would form a
# cycle, so use the shell as the concrete readiness boundary instead.
After=plasma-plasmashell.service

# No ConditionEnvironment: this service talks to the session bus, not to the
# compositor, so a Wayland check was wrong on its own terms -- and conditions
# are evaluated once, so a not-yet-imported variable silently skips the unit
# for the whole session rather than delaying it.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/lnp-errord
Restart=on-failure
RestartSec=5

[Install]
WantedBy=plasma-workspace.target
