# ------------------------------------------------------------------- wiring


def write_stamp():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STAMP.write_text("1\n")


def main() -> int:
    args = sys.argv[1:]

    if "--dump-state" in args:
        for key, value in system_state().items():
            print(f"{key}={value}")
        return 0

    # From autostart, appear once: after the user has seen the wizard we stamp,
    # and every later login exits here silently. The menu entry has no flag and
    # always shows.
    if "--autostart" in args and STAMP.exists():
        return 0

    app = QApplication(sys.argv)
    app.setApplicationName("lnp-welcome")
    app.setDesktopFileName("lnp-welcome")

    state = system_state()

    wizard = QWizard()
    wizard.setWindowTitle("Welcome")
    wizard.setWizardStyle(QWizard.WizardStyle.ClassicStyle)
    wizard.setOption(QWizard.WizardOption.NoBackButtonOnStartPage, True)
    wizard.resize(720, 540)

    wizard.addPage(WelcomePage(state))
    wizard.addPage(MediaPage(state))
    wizard.addPage(DriversPage(state))
    wizard.addPage(CleanPage(state))
    wizard.addPage(SecurePage())
    wizard.addPage(TourPage())
    wizard.addPage(DonePage())

    wizard.show()
    code = app.exec()

    # Seen once is enough, however it was closed: a wizard that reappears
    # every login because you closed it "wrong" is nagware.
    write_stamp()
    return code


if __name__ == "__main__":
    sys.exit(main())
