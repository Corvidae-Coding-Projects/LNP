#!/usr/bin/python3
"""lnp-welcome -- the first-run welcome app for Linux for Normal People.

This is where the project's promise is kept or broken: everything LNP can do
must be reachable from here with a mouse. The copy follows the error-message
literature (plain language, say what happened, say what to do next); the
structure is a plain wizard because a wizard is the one GUI idiom nobody has
ever needed explained to them.

Privileged work (codecs, drivers) is delegated to /usr/libexec/lnp-setup via
pkexec, so the only password prompt the user ever sees is the system's own
authentication dialog.
"""

import os
import shutil
import subprocess
import sys
from pathlib import Path

from PySide6.QtCore import QProcess, Qt
from PySide6.QtWidgets import (
    QApplication,
    QCheckBox,
    QHBoxLayout,
    QLabel,
    QMessageBox,
    QPlainTextEdit,
    QPushButton,
    QVBoxLayout,
    QWizard,
    QWizardPage,
)

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "lnp"
STAMP = STATE_DIR / "welcome-done"


# --------------------------------------------------------------- system state


def _run(cmd: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, check=False)


def rpm_installed(name: str) -> bool:
    return _run(["rpm", "-q", name]).returncode == 0


def has_nvidia_gpu() -> bool:
    # Vendor 10de is NVIDIA; class 03xx is a display controller.
    out = _run(["lspci", "-n", "-d", "10de:"]).stdout
    return any(line.split()[1].startswith("03") for line in out.splitlines() if line.split())


def nvidia_driver_loaded() -> bool:
    try:
        return any(l.startswith("nvidia ") for l in Path("/proc/modules").read_text().splitlines())
    except OSError:
        return False


def dock_enabled() -> bool:
    return _run(["systemctl", "--user", "is-enabled", "lnp-dock.service"]).stdout.strip() == "enabled"


def have_backup() -> bool:
    return (STATE_DIR / "backup-latest").exists()


def disk_percent(path="/") -> int:
    st = os.statvfs(path)
    used = st.f_blocks - st.f_bfree
    total = used + st.f_bavail
    return int(round(used * 100 / total)) if total else 0


def system_state() -> dict:
    return {
        "disk_percent": disk_percent("/"),
        "codecs": rpm_installed("ffmpeg") and rpm_installed("gstreamer1-plugins-ugly"),
        "nvidia_gpu": has_nvidia_gpu(),
        "nvidia_driver": rpm_installed("akmod-nvidia"),
        "nvidia_loaded": nvidia_driver_loaded(),
        "dock_enabled": dock_enabled(),
        "have_backup": have_backup(),
    }


# ------------------------------------------------------------------ UI pieces


def body_label(text: str) -> QLabel:
    label = QLabel(text)
    label.setWordWrap(True)
    label.setTextFormat(Qt.TextFormat.RichText)
    return label


class ActionPage(QWizardPage):
    """A page with one privileged action button and honest progress reporting.

    The pattern both the codecs and driver pages share: a "do it" button, a
    live status line fed from the helper's ==> messages, and the full output
    tucked behind a details toggle -- visible when wanted, never forced on
    someone it would only alarm.
    """

    def __init__(self, action: str, button_text: str, done_text: str):
        super().__init__()
        self.action = action
        self.done_text = done_text
        self.proc: QProcess | None = None
        self.pending_output = ""

        self.layout_ = QVBoxLayout(self)

        self.button = QPushButton(button_text)
        self.button.clicked.connect(self.start)

        self.status = QLabel("")
        self.status.setWordWrap(True)

        self.details_toggle = QPushButton("Show details")
        self.details_toggle.setFlat(True)
        self.details_toggle.setVisible(False)
        self.details_toggle.clicked.connect(self.toggle_details)

        self.log = QPlainTextEdit()
        self.log.setReadOnly(True)
        self.log.setVisible(False)
        self.log.setMaximumBlockCount(2000)

    def finish_layout(self):
        self.layout_.addWidget(self.button)
        self.layout_.addWidget(self.status)
        self.layout_.addWidget(self.details_toggle)
        self.layout_.addWidget(self.log)
        self.layout_.addStretch(1)

    def toggle_details(self):
        show = not self.log.isVisible()
        self.log.setVisible(show)
        self.details_toggle.setText("Hide details" if show else "Show details")

    def start(self):
        self.button.setEnabled(False)
        self.status.setText("Working… this can take a few minutes.")
        self.details_toggle.setVisible(True)
        self.log.clear()
        self.pending_output = ""

        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.proc.readyReadStandardOutput.connect(self.on_output)
        self.proc.finished.connect(self.on_finished)
        # --disable-internal-agent: if no graphical password dialog can be
        # reached, fail cleanly instead of grasping for a terminal that a
        # GUI process does not have (seen in the wild: "Error opening current
        # controlling terminal ... /dev/tty"). We then explain it honestly.
        self.proc.start(
            "pkexec", ["--disable-internal-agent", "/usr/libexec/lnp-setup", self.action]
        )

    def on_output(self):
        self.pending_output += bytes(self.proc.readAllStandardOutput()).decode(errors="replace")
        lines = self.pending_output.split("\n")
        self.pending_output = lines.pop()
        for line in lines:
            line = line.rstrip("\r")
            self.log.appendPlainText(line)
            # The helper's ==> lines are written to be shown to people.
            if line.startswith("==> "):
                self.status.setText(line[4:])

    def on_finished(self, code: int, exit_status):
        if self.proc is not None:
            self.on_output()
        if self.pending_output:
            self.log.appendPlainText(self.pending_output)
            self.pending_output = ""
        log_text = self.log.toPlainText()
        authorization_failed = (
            exit_status == QProcess.ExitStatus.NormalExit
            and code in (126, 127)
            and not any(line.startswith("==> ") for line in log_text.splitlines())
        )

        if code == 0 and exit_status == QProcess.ExitStatus.NormalExit:
            if any(line.startswith("==> Skipped:") for line in log_text.splitlines()):
                self.status.setText("Completed available steps. Some steps were skipped; see details below.")
                if not self.log.isVisible():
                    self.toggle_details()
            else:
                self.status.setText("✓ " + self.done_text)
            self.button.setVisible(False)
        elif authorization_failed and (
            "authentication agent" in log_text or "controlling terminal" in log_text
        ):
            # polkit could not show a password dialog at all. Distinct from a
            # wrong or missing password, and telling the user it was their
            # password would be a lie.
            self.status.setText(
                "The screen that asks for the administrator password couldn't "
                "be opened. Nothing was changed. Log out, log back in, and try "
                "this again."
            )
            self.button.setEnabled(True)
        elif authorization_failed:
            # pkexec: dialog dismissed / wrong password.
            self.status.setText(
                "That needs the administrator password, and it wasn't entered. "
                "Nothing was changed — you can try again whenever you like."
            )
            self.button.setEnabled(True)
        else:
            self.status.setText(
                "Setup did not finish. Some changes may already have been made. "
                "Open the details below to see which steps completed and what failed. "
                "You can retry; completed steps may remain in place."
            )
            if not self.log.isVisible():
                self.toggle_details()
            self.button.setEnabled(True)


class WelcomePage(QWizardPage):
    def __init__(self, state: dict):
        super().__init__()
        self.setTitle("Welcome to your new desktop")

        layout = QVBoxLayout(self)
        layout.addWidget(
            body_label(
                "Your desktop has been set up the LNP way:"
                "<ul>"
                "<li>A <b>dock</b> at the bottom — your apps, one click away. "
                "Icons grow as you point at them.</li>"
                "<li>A <b>menu bar</b> at the top with the clock and system icons.</li>"
                "<li>Window buttons on the <b>left</b>, close first.</li>"
                "</ul>"
                "The next pages check that videos play and your hardware works. "
                "Nothing happens without your say-so."
            )
        )

        self.dock_toggle = QCheckBox("Show the dock")
        self.dock_toggle.setChecked(state["dock_enabled"])
        self.dock_toggle.toggled.connect(self.toggle_dock)
        layout.addWidget(self.dock_toggle)

        apply_layout = QPushButton("Apply the LNP desktop layout…")
        apply_layout.clicked.connect(self.apply_layout)
        layout.addWidget(apply_layout)

        layout.addStretch(1)

        if state["have_backup"]:
            layout.addWidget(
                body_label(
                    "<b>Prefer things how they were?</b> Your previous desktop "
                    "was saved before anything changed."
                )
            )
            restore = QPushButton("Restore my old desktop…")
            restore.clicked.connect(self.restore)
            row = QHBoxLayout()
            row.addWidget(restore)
            row.addStretch(1)
            layout.addLayout(row)

    def toggle_dock(self, on: bool):
        verb = "enable" if on else "disable"
        _run(["systemctl", "--user", verb, "--now", "lnp-dock.service"])

    def apply_layout(self):
        answer = QMessageBox.question(
            self,
            "Apply the LNP desktop layout?",
            "This rebuilds your desktop panels and saves a backup first. "
            "It also resumes automatic LNP layout updates at login.",
        )
        if answer != QMessageBox.StandardButton.Yes:
            return
        result = _run(["lnp-apply-layout", "--force"])
        if result.returncode == 0:
            QMessageBox.information(self, "LNP layout applied", "The LNP layout is ready.")
        else:
            QMessageBox.warning(
                self, "Layout did not finish",
                "The LNP layout could not be fully applied. "
                "Any completed backup is kept.\n\n" + result.stderr.strip(),
            )

    def restore(self):
        answer = QMessageBox.question(
            self,
            "Restore your old desktop?",
            "This restores your saved desktop configuration and pauses automatic "
            "LNP layout updates. Older backups may leave some newer settings in place. "
            "The change finishes the next time you log in.\n\n"
            "You can come back to the LNP desktop later from this app.",
        )
        if answer != QMessageBox.StandardButton.Yes:
            return

        result = _run(["lnp-apply-layout", "--revert"])
        if result.returncode == 0:
            box = QMessageBox(self)
            box.setWindowTitle("Old desktop restored")
            box.setText("Done. Log out and back in to see it.")
            logout = box.addButton("Log out now", QMessageBox.ButtonRole.AcceptRole)
            box.addButton("Later", QMessageBox.ButtonRole.RejectRole)
            box.exec()
            if box.clickedButton() is logout:
                _run([
                    "gdbus", "call", "--session",
                    "--dest", "org.kde.Shutdown",
                    "--object-path", "/Shutdown",
                    "--method", "org.kde.Shutdown.logout",
                ])
        else:
            QMessageBox.warning(
                self,
                "That didn't work",
                "The saved copy of your old desktop couldn't be fully restored. "
                "Some settings may already have been restored. The backup is kept.\n\n"
                + result.stderr.strip(),
            )


