[Unit]
Description=LNP Dock
# A Wayland client is useless before the session's compositor socket exists.
PartOf=graphical-session.target
After=graphical-session.target
# Plasma imports WAYLAND_DISPLAY into the systemd user environment at session
# start; if it is absent this is not a Wayland session and the dock cannot run.
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/lnp-dock
# The dock holds no state, so the recovery story for a crash is simply to be
# there again before the user finishes wondering where it went.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=plasma-workspace.target
