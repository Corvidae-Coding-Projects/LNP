[Unit]
Description=LNP security alert notifications
PartOf=graphical-session.target
After=graphical-session.target

# No ConditionEnvironment: this watcher needs the session bus for
# notifications and the system bus for setroubleshootd, not the compositor.
# Conditions are evaluated once and skip silently, which is how every LNP
# user service came up inactive after a reboot.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/lnp-selinux --watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=plasma-workspace.target
